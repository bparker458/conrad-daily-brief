# ── Supabase (server only — never exposed to the client) ─────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── App auth ──────────────────────────────────────────────────────────
# bcrypt hash of Brad's passphrase. Generate with:  npm run hash -- "the phrase"
APP_PASSPHRASE_HASH=
# Signs the session cookie. Generate with:  openssl rand -hex 32
SESSION_SECRET=
# Bearer token Conrad uses (Section 9 of the handoff). Generate with:  openssl rand -hex 32
CONRAD_API_SECRET=

NEXT_PUBLIC_APP_NAME=Daily Brief

# ── Phase 3 only: Google (read-only Calendar + Gmail) ────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
