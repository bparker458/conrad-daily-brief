# ── Supabase (server only — never exposed to the client) ─────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── App auth ───────────────────────────────────────────────
# bcrypt hash of Brad's passphrase. Generate with:  npm run hash -- "the phrase"
APP_PASSPHRASE_HASH=
# Signs the session cookie. Generate with:  openssl rand -hex 32
SESSION_SECRET=
# Bearer token Conrad uses. Generate with:  openssl rand -hex 32
CONRAD_API_SECRET=

NEXT_PUBLIC_APP_NAME=Command Dashboard

# ── Conrad's step-writer ("I'm not sure" suggestions) ─────────────────
# Server only — never exposed to the client (check-bundle enforces).
# Leave empty to disable: the button then just flags the task for Conrad.
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-sonnet-5 in lib/suggest.ts
CONRAD_SUGGEST_MODEL=

# ── Microsoft Graph: Outlook mail + calendar, READ ONLY ──────────────
# Delegated access to Brad's own mailbox. Mint the refresh token with:
#   MS_CLIENT_ID=... MS_CLIENT_SECRET=... npm run ms:token
# Scopes: offline_access Mail.Read Calendars.Read User.Read
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Use the LZB Oregon tenant id, or leave as 'common'
MS_TENANT_ID=common
MS_REFRESH_TOKEN=

# ── Google: Calendar + Gmail, READ ONLY ───────────────────────────
#   npm run google:token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Who counts as a priority sender ──────────────────────────────
# Unread mail from these addresses is surfaced immediately instead of
# waiting for the 24 hour rule. Comma separated, lowercase.
PRIORITY_SENDERS=
